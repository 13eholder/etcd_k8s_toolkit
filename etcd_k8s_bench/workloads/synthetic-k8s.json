{
  "name": "synthetic-k8s",
  "seed": 1,
  "topology": { "node_count": 2000, "pod_count": 40000, "namespace_count": 100 },
  "controllers": { "daemonset_count": 10, "pods_per_deployment": 100 },
  "value_size_bytes": {
    "pods": 4096,
    "nodes": 4096,
    "node_leases": 512,
    "deployments": 4096,
    "replicasets": 4096,
    "daemonsets": 4096
  },
  "load": {
    "duration_ms": 600000,
    "update_rps": 10000,
    "read_ratio": { "numerator": 1, "denominator": 20 },
    "update_weights": { "pods": 95, "deployments": 2, "replicasets": 2, "daemonsets": 1 },
    "read_weights": { "pods": 90, "nodes": 5, "deployments": 2, "replicasets": 2, "daemonsets": 1 },
    "read_shape_weights": { "point": 90, "bounded_list": 10 },
    "list_limit": 100
  },
  "periodic": {
    "node_lease_interval_ms": 10000,
    "node_lease_jitter_percent": 5,
    "node_status_interval_ms": 300000,
    "status_interval_ms": 10000,
    "compact_interval_ms": 60000
  },
  "watch": {
    "subscriptions_per_root": 1,
    "start_revision": 0,
    "prev_kv": true,
    "progress_notify": true
  },
  "execution": {
    "workers": 128,
    "queue_capacity": 4096,
    "request_timeout_ms": 5000,
    "operation_timeout_ms": 10000,
    "preparation_timeout_ms": 180000,
    "drain_timeout_ms": 10000,
    "watch_teardown_timeout_ms": 5000
  },
  "report": { "bucket_ms": 1000, "memory_limit_mib": 128 }
}
